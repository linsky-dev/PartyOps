    <OutputType>WinExe</OutputType>
    <AssemblyName>PartyOps.DocumentFormatter.Desktop</AssemblyName>
    <RootNamespace>PartyOps.DocumentFormatter.Desktop</RootNamespace>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <TargetFrameworkProfile />
    <LangVersion>12.0</LangVersion>
    <Nullable>annotations</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <OutputPath Condition=" '$(Platform)' == 'AnyCPU' Or '$(Platform)' == 'Any CPU' ">bin\$(Configuration)\</OutputPath>
