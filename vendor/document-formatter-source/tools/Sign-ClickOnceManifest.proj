<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <UsingTask TaskName="PartyOps.DocumentFormatter.Build.SignClickOnceManifestTask"
             AssemblyFile="$(MSBuildProjectDirectory)\ManifestSigningTask\bin\Release\PartyOps.DocumentFormatter.ManifestSigningTask.dll" />

  <Target Name="Sign">
    <Error Condition="!Exists('$(ManifestPath)')" Text="签名清单不存在：$(ManifestPath)" />
    <Error Condition="!Exists('$(CertificatePath)')" Text="签名证书不存在：$(CertificatePath)" />
    <PartyOps.DocumentFormatter.Build.SignClickOnceManifestTask ManifestPath="$(ManifestPath)"
                                                   CertificatePath="$(CertificatePath)"
                                                   TimestampUrl="$(TimestampUrl)" />
  </Target>
</Project>
