{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "version",
    "required_packages",
    "passed_packages",
    "all_packages_runtime_gate",
    "packages",
    "source_fingerprint",
    "package_inventory",
    "package_errors",
    "signing_and_distribution_gate",
    "report_path"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "pattern": "\\+08:00$"},
    "version": {"type": "string", "minLength": 1},
    "required_packages": {"type": "integer", "minimum": 1},
    "passed_packages": {"type": "integer", "minimum": 0},
    "all_packages_runtime_gate": {"enum": ["passed", "blocked"]},
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "required_targets",
          "runtime_environment_passed",
          "real_environment_passed",
          "package_sha256",
          "targets"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "required_targets": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "runtime_environment_passed": {"type": "boolean"},
          "real_environment_passed": {"type": "boolean"},
          "package_sha256": {
            "anyOf": [
              {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              {"type": "null"}
            ]
          },
          "targets": {"type": "object"}
        }
      }
    },
    "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_inventory": {"type": "object"},
    "package_errors": {"type": "object"},
    "signing_and_distribution_gate": {"enum": ["passed", "blocked", "not_run"]},
    "report_path": {"type": "string", "minLength": 1}
  }
}
